{
    "name": "@kittycrypto/website",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./static-ui": "./src/contracts/staticUi.tsx",
        "./keyboard": "./src/keyboard.ts"
    },
    "scripts": {
        "clean": "node -e \"import('node:fs').then(({ rmSync }) => { rmSync('dist', { recursive: true, force: true }); rmSync('site', { recursive: true, force: true }); })\"",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
        "build:assets": "tsx build.mts",
        "build:pages": "bun scripts/build-pages.ts",
        "build": "npm run build:assets && npm run build:pages",
        "check:routes": "tsx scripts/check-routes.mts",
        "validate": "npm run typecheck && npm run check:nesting && npm run check:architecture && npm run check:entries && npm run build && npm run check:routes",
        "check:nesting": "tsx scripts/check-conditional-nesting.mts",
        "check:architecture": "tsx scripts/check-architecture.mts",
        "check:entries": "tsx scripts/check-entry-contract.mts",
        "check:parity": "tsx scripts/check-refactor-parity.mts"
    },
    "devDependencies": {
        "@types/node": "^25.2.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "bun": "1.4.0",
        "esbuild": "^0.27.4",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "dotenv": "^17.3.1",
        "esbuild-wasm": "^0.28.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    }
}
